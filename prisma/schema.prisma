generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WaveDirection {
  UP
  DOWN
  SIDEWAYS
  UP_AFTER_PULLBACK
  DOWN_AFTER_REBOUND
  REBOUND
  PULLBACK
}

enum WaveValidationStatus {
  PENDING
  HIT
  PARTIAL
  FAILED
  EXPIRED
}

model WaveAnalyst {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  source      String?
  active      Boolean          @default(true)
  baseWeight  Float            @default(0.05)
  maxWeight   Float            @default(0.22)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  predictions WavePrediction[]
}

model WavePrediction {
  id                String               @id @default(cuid())
  analystId         String
  analyst           WaveAnalyst          @relation(fields: [analystId], references: [id], onDelete: Cascade)
  marketCode        String
  marketName        String
  timeframe         String               @default("1D")
  publishedAt       DateTime
  validUntil        DateTime?
  direction         WaveDirection
  summary           String
  waveLabel         String?
  supportLevels     Json
  resistanceLevels  Json
  targetLevels      Json
  invalidationLevel Float?
  confirmationLevel Float?
  expectedPath      Json?
  sourceImageUrl    String?
  sourceMessageId   String?
  rawText           String?
  status            WaveValidationStatus @default(PENDING)
  entryReference    Float?
  maxFavorableMove  Float?
  maxAdverseMove    Float?
  realizedReturn    Float?
  rewardRisk        Float?
  validatedAt       DateTime?
  validationNote    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([marketCode, publishedAt])
  @@index([analystId, status])
  @@unique([analystId, marketCode, publishedAt])
}

model ReferralInvite {
  id         String   @id @default(cuid())
  inviterId  String   @unique @map("inviter_id")
  inviteCode String   @unique @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("ReferralInvite")
}

model ReferralRecord {
  id            String   @id @default(cuid())
  inviterId     String   @map("inviter_id")
  inviteeId     String   @map("invitee_id")
  paymentId     String?  @map("payment_id")
  status        String   @default("pending")
  rewardDays    Int      @default(7) @map("reward_days")
  deviceId      String?  @map("device_id")
  flaggedReason String?  @map("flagged_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([inviteeId])
  @@index([inviterId])
  @@index([status])
  @@index([paymentId])
  @@map("ReferralRecord")
}

/// Formal weekly Liu Yao (六爻) sources — daily forecasts must trace here when present.
model WeeklyForecastSource {
  id               String    @id
  marketCode       String
  periodStart      String
  periodEnd        String
  primaryHexagram  String?
  changedHexagram  String?
  movingLines      Int[]
  specialPatterns  String[]
  weeklyDirection    String
  weeklyPath        String
  interpretation   String
  riskSummary      String
  sourceType       String    @default("LIUYAO_WEEKLY")
  version          Int       @default(1)
  status           String    @default("LOCKED")
  publishedAt      DateTime?
  lockedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([marketCode, periodStart, version])
  @@index([marketCode, periodStart, periodEnd])
  @@index([status])
  @@map("WeeklyForecastSource")
}

/// Generated daily forecasts linked to a weekly source (versioned; locked rows never overwritten).
model GeneratedDailyForecast {
  id                     String    @id
  marketCode             String
  forecastDate           String
  sourceWeeklyForecastId String
  direction              String
  upProbability          Int
  sidewaysProbability    Int
  downProbability        Int
  expectedPath           String
  supportLevels          Json?
  resistanceLevels       Json?
  confirmationLevel      String?
  invalidationLevel      String?
  riskLevel              String?
  catalysts              Json?
  risks                  Json?
  liuyaoEvidence         String?
  qimenEvidence          String?
  calendarEvidence       Json?
  technicalEvidence      String?
  newsEvidence           String?
  marketProgressStatus   String    @default("NOT_STARTED")
  revisionReason         String?
  previousVersionId      String?
  version                Int       @default(1)
  status                 String    @default("DRAFT")
  generatedAt            DateTime  @default(now())
  publishedAt            DateTime?
  lockedAt               DateTime?
  validatedAt            DateTime?
  validationStatus       String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([marketCode, forecastDate, version])
  @@index([forecastDate, status])
  @@index([sourceWeeklyForecastId])
  @@map("GeneratedDailyForecast")
}

/// I Ching (六爻) research engine — admin-only storage + evidence binding.
/// Public / member endpoints MUST NOT return rawTranscript, masterOriginalAnalysis, internalAnalysis,
/// per-line data, images, or long-horizon research details unless bound & explicitly allowed.
model IChingResearch {
  id                   String   @id
  assetId              String
  question             String
  forecastType         String
  forecastStartAt      String
  forecastEndAt        String
  castAt                DateTime
  timezone             String   @default("Asia/Shanghai")
  sourceType            String
  priority              String   @default("NORMAL")
  researchStatus       String

  hexagramName              String
  changedHexagramName      String?
  hexagramSpecialTypes     Json?

  movingLines          Json?

  monthStemBranch      String?
  dayStemBranch        String?
  emptyBranches       Json?

  usefulGod            String?
  worldLine            Json?
  responseLine         Json?
  lineData             Json?

  rawImageUrls        Json?
  rawTranscript       String?

  masterOriginalAnalysis      String?
  masterStructuredSummary     String?
  internalAnalysis            String?
  analysisSteps               Json?
  timeWindows                Json?

  pathConclusion       String?
  directionConclusion  String?
  confidence           Int?

  /// Teacher-side final direction/path (used when adoptedSource = MASTER).
  masterFinalConclusion String?
  masterConfidence      Int?
  masterPathConclusion  String?
  masterDirectionConclusion String?

  /// Internal-side final direction/path (used when adoptedSource = INTERNAL).
  internalFinalConclusion String?
  internalConfidence       Int?
  internalPathConclusion   String?
  internalDirectionConclusion String?

  /// Which source was adopted into a formal prediction / evidence.
  adoptedSource        String   @default("NONE")
  adoptedResearchId    String?

  /// For each research record: whether MASTER should override INTERNAL when both exist.
  masterOverride       Boolean  @default(false)

  knowledgeVersion     String?
  version              Int      @default(1)

  createdBy            String?
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  createdCases         MasterCase[]
  versions             IChingResearchVersion[]
  validations          IChingValidation[]

  @@index([assetId, forecastStartAt])
  @@index([researchStatus])
}

model IChingResearchVersion {
  id            String   @id
  researchId    String
  version       Int
  snapshot      Json
  changeReason  String
  changedBy     String?
  createdAt     DateTime @default(now())

  research IChingResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@unique([researchId, version])
  @@index([researchId])
}

model MasterRule {
  id                   String   @id
  ruleCode             String   @unique
  title                String
  category             String
  ruleText             String
  teacherOriginalText String?
  structuredLogic      Json?
  applicableMarkets   Json?
  applicableForecastTypes Json?
  priority             Int      @default(50)
  confidence          Int?
  status               String   @default("DRAFT")

  sourceResearchId    String?
  supersedesRuleId    String?

  /// Master Intelligence Engine — optional lesson provenance
  lessonId            String?
  candidateId         String?
  voiceHints          Json?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([lessonId])
  @@index([status])
}

model MasterCase {
  id              String   @id
  researchId      String?
  lessonId        String?
  candidateId     String?
  caseTitle       String
  assetId         String
  question        String?
  forecastStartAt String
  forecastEndAt   String
  teacherConclusion String?
  actualResult    String?
  validationScore Int?
  validationStatus String?
  lessons         String?
  hitStatus       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  research IChingResearch? @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@index([assetId, forecastStartAt])
  @@index([lessonId])
}

model IChingValidation {
  id                 String   @id
  researchId         String
  actualDirection    String?
  actualOpen         Float?
  actualHigh         Float?
  actualLow          Float?
  actualClose        Float?
  actualPath         String?
  result             String?
  directionScore     Int?
  pathScore          Int?
  timingScore        Int?
  levelScore         Int?
  totalScore         Int?
  validationNotes    String?
  verifiedBy         String?
  verifiedAt         DateTime?

  research IChingResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@index([researchId])
}

/// ========== Master Intelligence Engine (Lesson → Knowledge) ==========

model Lesson {
  id            String   @id
  title         String
  teacher       String   @default("老师")
  course        String?
  lessonNumber  Int?
  uploadTime    DateTime @default(now())
  durationSec   Int?
  source        String   @default("MASTER")
  status        String   @default("UPLOADED")
  mediaPath     String?
  mediaMime     String?
  mediaSize     Int?
  mediaFileName String?
  errorMessage  String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transcript  LessonTranscript?
  extraction  LessonExtraction?
  candidates  MasterKnowledgeCandidate[]

  @@index([status])
  @@index([uploadTime])
}

model LessonTranscript {
  id         String   @id
  lessonId   String   @unique
  /// Immutable raw transcript — never overwrite after first non-empty write.
  rawText    String   @default("")
  cleanText  String   @default("")
  language   String?  @default("zh-CN")
  rawLocked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonExtraction {
  id            String   @id
  lessonId      String   @unique
  status        String   @default("DRAFT")
  summary       String?
  rulesJson     Json?
  casesJson     Json?
  conceptsJson  Json?
  formulasJson  Json?
  exceptionsJson Json?
  predictionsJson Json?
  quotesJson    Json?
  lessonOutputJson Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model MasterKnowledgeCandidate {
  id           String   @id
  lessonId     String?
  kind         String
  title        String
  body         String
  payload      Json?
  weightStars  Int      @default(5)
  reviewStatus String   @default("DRAFT")
  publishedRef String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([kind, reviewStatus])
  @@index([lessonId])
}

model RuleTreeNode {
  id           String   @id
  ruleCode     String?
  parentId     String?
  label        String
  condition    String?
  yesChildId   String?
  noChildId    String?
  outcomeText  String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([parentId])
  @@index([ruleCode])
}

model KnowledgeNode {
  id        String   @id
  key       String   @unique
  label     String
  kind      String   @default("CONCEPT")
  weightStars Int    @default(5)
  sourceLessonId String?
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeEdge {
  id         String   @id
  fromKey    String
  toKey      String
  relation   String   @default("IMPLIES")
  weightStars Int     @default(4)
  sourceLessonId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromKey, toKey, relation])
  @@index([fromKey])
  @@index([toKey])
}

model KnowledgeConflict {
  id                 String   @id
  ruleCodeOrMotif    String
  leftCandidateId    String?
  rightCandidateId   String?
  leftText           String
  rightText          String
  hypothesizedCause  String?
  status             String   @default("OPEN")
  resolvedNote       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([ruleCodeOrMotif])
}

model MarketRuleWeight {
  id          String   @id
  ruleCode    String
  assetId     String
  weightStars Int      @default(4)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ruleCode, assetId])
}

model TeacherVoicePattern {
  id          String   @id
  phrase      String   @unique
  signal      String
  weightDelta Int      @default(0)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CaseValidationRun {
  id         String   @id
  caseId     String
  result     String
  score      Int?
  note       String?
  verifiedBy String?
  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([caseId])
}

model TeacherIntelligenceRun {
  id          String   @id
  query       String
  assetId     String?
  citations   Json
  analysis    String
  createdBy   String?
  createdAt   DateTime @default(now())
}

/// 六爻老师语音学习知识库（teacher_notes）
/// DB columns: id, audio_url, raw_text, summary, rules, cases, keywords, created_at
model TeacherNote {
  id           String   @id
  /// audio_url — storage path or public URL of uploaded media
  sourceAudio  String   @map("audio_url")
  rawText      String   @default("") @map("raw_text")
  summary      String   @default("")
  /// Structured sections: 老师核心规则 / 六亲 / 世应 / 财爻 / 旺衰 / 错误复盘 …
  rules        Json?
  /// 案例分析 array
  cases        Json?
  keywords     Json?
  /// Callable knowledge JSON (optional enrichment)
  knowledge    Json?
  status       String   @default("UPLOADED")
  progress     Int      @default(0)
  errorMessage String?  @map("error_message")
  createdTime  DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("teacher_notes")
  @@index([createdTime])
  @@index([status])
}

/// 预测结束后学习反馈 / 复盘
model TeacherLearningFeedback {
  id              String   @id
  teacherNoteId   String?
  assetId         String?
  query           String?
  prediction      String
  actual          String
  correct         Boolean
  reviewNote      String?
  createdAt       DateTime @default(now())

  @@index([assetId])
  @@index([createdAt])
  @@map("teacher_learning_feedback")
}

/// ========== MoonX 老师投资六爻知识库（文字录入，非音视频）==========

model TeacherLesson {
  id                String   @id
  /// Public code e.g. TL-0006
  lessonCode        String   @unique
  title             String
  teacherName       String   @default("")
  /// LIUYAO | QIMEN | BAZI | DAYAN | TECHNICAL | MACRO
  primaryMethod     String   @default("LIUYAO")
  auxiliaryMethods Json?
  courseSeries      String   @default("")
  lessonNumber      String   @default("")
  lessonDate        DateTime?
  originalFileName  String?
  /// AUDIO_TRANSCRIPT | VIDEO_TRANSCRIPT | MANUAL_NOTE | IMAGE_TRANSCRIPT | OTHER
  sourceType        String   @default("MANUAL_NOTE")
  assets            Json?
  timeframes        Json?
  tags              Json?
  /// 原始转写文字 — 永久保存，AI 不得覆盖
  rawTranscript     String   @db.Text
  cleanedTranscript String   @default("") @db.Text
  summary           String   @default("") @db.Text
  adminNotes        String   @default("") @db.Text
  /// DRAFT | ANALYZED | REVIEWING | APPROVED | ARCHIVED
  status            String   @default("DRAFT")
  version           Int      @default(1)
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  versions TeacherLessonVersion[]
  rules    TeacherRule[]
  cases    TeacherCase[]
  concepts TeacherConcept[]
  quotes   TeacherQuote[]
  methods  TeacherMethod[]

  @@index([status])
  @@index([teacherName])
  @@index([primaryMethod])
  @@index([courseSeries])
  @@index([createdAt])
  @@map("teacher_lessons")
}

model TeacherLessonVersion {
  id                String   @id
  lessonId          String
  version           Int
  rawTranscript     String   @db.Text
  cleanedTranscript String   @db.Text
  summary           String   @db.Text
  changeReason      String?
  changedBy         String?
  createdAt         DateTime @default(now())

  lesson TeacherLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, version])
  @@index([lessonId])
  @@map("teacher_lesson_versions")
}

model TeacherRule {
  id                   String   @id
  /// MR-0001
  ruleCode             String   @unique
  title                String
  /// USE_GOD | SHI_YING | PROSPERITY_DECLINE | ...
  category             String   @default("OTHER")
  conditions           Json?
  analysisSteps        Json?
  conclusion           String   @db.Text
  exceptions           Json?
  applicableAssets     Json?
  applicableTimeframes Json?
  keywords             Json?
  priority             Int      @default(50)
  confidence           Int      @default(50)
  sourceLessonId       String?
  sourceQuote          String   @db.Text
  sourceTextStart      Int?
  sourceTextEnd        Int?
  /// DRAFT | APPROVED | REJECTED | ARCHIVED | UNCERTAIN
  status               String   @default("DRAFT")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  lesson TeacherLesson? @relation(fields: [sourceLessonId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([sourceLessonId])
  @@index([title])
  @@map("teacher_rules")
}

model TeacherCase {
  id                    String   @id
  /// MC-0001
  caseCode              String   @unique
  title                 String
  asset                 String   @default("")
  question              String   @default("")
  predictionStart       String?
  predictionEnd         String?
  mainHexagram          String?
  changedHexagram       String?
  movingLines           String?
  useGod                String?
  shiLine               String?
  yingLine              String?
  monthBranch           String?
  dayBranch             String?
  sixRelationsStructure Json?
  hiddenFlyingStructure Json?
  teacherConclusion     String   @default("") @db.Text
  predictedPath         String   @default("") @db.Text
  timingWindows         Json?
  sourceLessonId        String?
  sourceQuote           String   @default("") @db.Text
  actualResult          String?
  /// PENDING | HIT | PARTIAL | MISS | UNVERIFIABLE
  validationStatus      String   @default("PENDING")
  validationNotes       String?
  /// DRAFT | APPROVED | ARCHIVED | REJECTED | UNCERTAIN
  status                String   @default("DRAFT")
  needsAdminFill        Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  lesson TeacherLesson? @relation(fields: [sourceLessonId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([asset])
  @@index([sourceLessonId])
  @@map("teacher_cases")
}

model TeacherConcept {
  id             String   @id
  name           String
  definition     String   @db.Text
  conditions     Json?
  sourceLessonId String?
  sourceQuote    String   @default("") @db.Text
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lesson TeacherLesson? @relation(fields: [sourceLessonId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([name])
  @@index([sourceLessonId])
  @@map("teacher_concepts")
}

model TeacherQuote {
  id             String   @id
  quote          String   @db.Text
  meaning        String   @default("") @db.Text
  /// HIGH_CERTAINTY | NEEDS_DEEPER_ANALYSIS | IMPORTANT | WARNING | NORMAL
  toneType       String   @default("NORMAL")
  sourceLessonId String?
  textPosition   Int?
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lesson TeacherLesson? @relation(fields: [sourceLessonId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([sourceLessonId])
  @@map("teacher_quotes")
}

model TeacherMethod {
  id             String   @id
  title          String
  steps          Json?
  conditions     Json?
  exceptions     Json?
  sourceLessonId String?
  sourceQuote    String   @default("") @db.Text
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lesson TeacherLesson? @relation(fields: [sourceLessonId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([sourceLessonId])
  @@map("teacher_methods")
}

model ConflictRecord {
  id             String   @id
  ruleAId        String
  ruleBId        String
  conflictType   String   @default("POSSIBLE")
  possibleReason String
  resolution     String?
  /// OPEN | RESOLVED | IGNORED
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ruleAId])
  @@index([ruleBId])
  @@index([status])
  @@map("conflict_records")
}

/// Legacy TLC audio logs (JSON-only app path; table retained if present)
model TeacherLearningLog {
  id            String   @id
  day           String
  lessonId      String?
  lessonTitle   String   @default("")
  rulesAdded    Int      @default(0)
  casesAdded    Int      @default(0)
  rulesRevised  Int      @default(0)
  pendingReview Int      @default(0)
  note          String?
  createdAt     DateTime @default(now())

  @@index([day])
  @@index([createdAt])
  @@map("teacher_learning_logs")
}

/// Objective weekly verification. Separate from daily accuracy.
model WeeklyVerificationRecord {
  id              String   @id
  weeklyAnalysisId String  @unique
  assetId         String
  symbol          String
  weekStart       String
  weekEnd         String
  predictedPattern String
  actualPattern   String?
  result          String   @default("PENDING")
  directionScore  Int?
  pathScore       Int?
  levelScore      Int?
  totalScore      Int?
  dataSource      String?
  explanation     String?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([weekEnd, result])
  @@index([assetId, weekStart])
}

/// Optional administrator override. Automation remains the default publisher.
model ForecastOverride {
  id            String   @id
  scope         String
  assetId       String
  targetDate    String
  direction     String?
  supportLevels Json?
  resistanceLevels Json?
  confirmation  String?
  invalidation  String?
  note          String?
  enabled       Boolean  @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([scope, assetId, targetDate])
  @@index([targetDate, enabled])
}


/// Paid-member device binding. Supabase auth user ids are stored as opaque strings.
model TrustedDevice {
  id              String   @id @default(cuid())
  userId          String
  deviceIdHash    String
  displayName     String
  userAgentFamily String?
  platformFamily  String?
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  verifiedAt      DateTime?
  revokedAt       DateTime?
  lastIpHash      String?
  lastRegion      String?

  @@unique([userId, deviceIdHash])
  @@index([userId, revokedAt])
  @@index([lastSeenAt])
}

/// One active paid-content lease per user. Expired leases may be acquired by another trusted device.
model MemberAccessLease {
  id           String   @id @default(cuid())
  userId       String   @unique
  deviceIdHash String
  acquiredAt   DateTime @default(now())
  heartbeatAt  DateTime @default(now())
  expiresAt    DateTime
  switchCount  Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@index([deviceIdHash])
  @@index([expiresAt])
}

/// Security audit without raw IP addresses, device tokens, passwords, or auth cookies.
model SecurityEvent {
  id          String   @id @default(cuid())
  userId      String
  deviceId    String?
  eventType   String
  actorUserId String?
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

// MOOX V7.20.3.1 unified live trading. Additive only; no existing model is modified.
model MooxUnifiedLiveAccount {
  id                        String                   @id @default(cuid())
  ownerKey                  String                   @unique
  accountScope              String
  displayName               String?
  agentId                   String?                  @unique
  mode                      String                   @default("MANAGE_ONLY")
  newEntriesEnabled         Boolean                  @default(false)
  positionManagementEnabled Boolean                  @default(true)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  settings                  MooxUnifiedLiveSetting[]
  slices                    MooxUnifiedLiveSlice[]
  events                    MooxUnifiedLiveEvent[]

  @@index([accountScope, mode])
}

model MooxUnifiedLiveSetting {
  id                     String                 @id @default(cuid())
  accountId              String
  horizon                String
  enabled                Boolean                @default(true)
  sizingMode             String
  sizingValue            Float
  leverage               Int                    @default(1)
  maxOpenPositions       Int                    @default(1)
  maxLossPercent         Float                  @default(0.5)
  dailyLossPercent       Float                  @default(1)
  weeklyLossPercent      Float                  @default(2.5)
  maxMarginUsePercent    Float                  @default(25)
  target1ReducePercent   Float                  @default(30)
  isolatedMargin         Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  account                MooxUnifiedLiveAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, horizon])
  @@index([horizon, enabled])
}

model MooxUnifiedLiveSlice {
  id                  String                 @id @default(cuid())
  accountId           String
  symbol              String
  horizon             String
  side                String
  status              String                 @default("PENDING")
  sourceKind          String
  exchangePositionKey String?
  strategyDecisionId  String?
  marginAmount        Float                  @default(0)
  notionalAmount      Float                  @default(0)
  quantity            Float                  @default(0)
  leverage            Int                    @default(1)
  entryPrice          Float
  stopPrice           Float?
  target1             Float?
  target2             Float?
  maxHoldMinutes      Int
  openedAt            DateTime               @default(now())
  lastManagedAt       DateTime?
  nextCheckAt         DateTime?
  closedAt            DateTime?
  closeReason         String?
  qimenDirection      String?
  liuyaoDirection     String?
  resonance           String?
  technicalEntry      String?
  publicVisible       Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  account             MooxUnifiedLiveAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@index([symbol, status])
  @@index([exchangePositionKey])
}

model MooxUnifiedLiveEvent {
  id          String                 @id @default(cuid())
  accountId   String
  code        String
  severity    String
  detail      String
  symbol      String?
  sliceId     String?
  positionKey String?
  createdAt   DateTime               @default(now())
  account     MooxUnifiedLiveAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([code, severity])
}
