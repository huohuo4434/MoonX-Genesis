# MOOX Bitget Local Agent v1 - copy to a local private file and load it in your shell.
# Never paste BITGET_API_SECRET or BITGET_API_PASSPHRASE into mooxintel.com.
MOOX_SIGNAL_TOKEN=
MOOX_SYMBOLS=BTCUSDT
MOOX_METHOD=LIUYAO_CHAN

# Safe default. PAPER does not call Bitget and needs no Bitget credentials.
MOOX_AGENT_MODE=PAPER
MOOX_AGENT_STATE_FILE=.moox-agent-state.json
MOOX_AGENT_KILL_SWITCH=MOOX_AGENT_STOP

# DRY_RUN/LIVE only. Keep these on this PC/VPS. Use UTA trade + management,
# and NEVER grant withdraw or transfer capability.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# true (recommended): LIVE requires a Bitget IP whitelist.
# false: allows dynamic/no public IP, with higher key-theft risk.
MOOX_REQUIRE_IP_WHITELIST=true

MOOX_MAX_RISK_PER_TRADE_PCT=0.5
MOOX_MAX_POSITION_PCT=5
MOOX_MAX_TOTAL_POSITION_PCT=20
MOOX_MAX_ACCOUNT_LEVERAGE=2

# LIVE remains disabled unless both exact values below are explicitly set locally.
MOOX_ENABLE_LIVE=false
MOOX_LIVE_CONFIRMATION=
# MOOX_LIVE_CONFIRMATION=I_ACCEPT_LOCAL_LIVE_RISK
